2）、提交表单时使用JS验证：①账号为4-8个字符；②密码不能为空，且二次密码必须相同。（7分）
<script>
function checkval(){
	var name=document.getElementById('name');
	var passwd1=document.getElementById('passwd');
	var passwd2=document.getElementById('passwd2');
	var pattern=/^\w{4,8}$/；
	if(!pattern.test(name)){
	alert('账号必须为[4,8]位字符');
	name.focus();
	return false;
	}
	if(passwd.value==''){
	alert('密码不能为空');
	passwd1.focus();
	return false;
	}
	if(passwd2.value!=passwd.value){
	alert('两次密码不相同');
	passwd.value=' ';
	passwd2.focus();
	return false;
	}
	return true;
}
</script>
